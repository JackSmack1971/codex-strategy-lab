{
  "$schema": "research-schema-subset/1",
  "title": "Trial",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "hypothesis_id",
    "hypothesis_version",
    "family_id",
    "preregistration_sha256",
    "trial_sequence",
    "run_id",
    "data_snapshot_ids",
    "train_range",
    "validation_range",
    "holdout_class",
    "test_access_count",
    "feature_set_hash",
    "parameter_hash",
    "code_commit",
    "cost_model_hash",
    "execution_model_hash",
    "random_seed",
    "requested_by",
    "start_time",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "trial_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "hypothesis_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "hypothesis_version": {
      "type": "integer",
      "minimum": 1
    },
    "family_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "preregistration_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "trial_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "data_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "train_range": {
      "$ref": "common.schema.json#/$defs/time_range"
    },
    "validation_range": {
      "$ref": "common.schema.json#/$defs/time_range"
    },
    "holdout_class": {
      "$ref": "common.schema.json#/$defs/holdout_class"
    },
    "test_access_count": {
      "type": "integer",
      "minimum": 0
    },
    "feature_set_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "parameter_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cost_model_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "execution_model_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "requested_by": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "start_time": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "status": {
      "enum": [
        "STARTED",
        "COMPLETED",
        "FAILED",
        "ABORTED",
        "INTERRUPTED",
        "SUPERSEDED"
      ]
    },
    "test_range": {
      "$ref": "common.schema.json#/$defs/time_range"
    },
    "dirty_diff_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "end_time": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "metrics_ref": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "failure_code": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "artifact_manifest_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
